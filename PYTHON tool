# 2) IP-Scanner: Geraete im lokalen Netzwerk
# ----------------------------------------------------------------------------
def local_ip():
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(("8.8.8.8", 80))  # es wird kein Paket gesendet
        return s.getsockname()[0]
    except Exception:
        return None
    finally:
        s.close()


def ping(ip):
    cmd = (["ping", "-n", "1", "-w", "700", ip] if os.name == "nt"
           else ["ping", "-c", "1", "-W", "1", ip])
    try:
        out = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                             timeout=4).stdout.decode("utf-8", "ignore").lower()
        return "ttl=" in out
    except Exception:
        return False


def arp_table():
    table = {}
    try:
        out = subprocess.run(["arp", "-a"], stdout=subprocess.PIPE,
                             stderr=subprocess.DEVNULL,
                             timeout=6).stdout.decode("utf-8", "ignore")
    except Exception:
        return table
    for line in out.splitlines():
        ip = re.search(r"(\d{1,3}(?:\.\d{1,3}){3})", line)
        mac = re.search(r"((?:[0-9a-fA-F]{1,2}[:-]){5}[0-9a-fA-F]{1,2})", line)
        if ip and mac:
            table[ip.group(1)] = mac.group(1).replace("-", ":").upper()
    return table


def ip_scanner():
    own = local_ip()
    if not own:
        print(f"  {RED}Kein Netzwerk gefunden.{RESET}")
        return
    default_base = ".".join(own.split(".")[:3])
    print(f"  Deine lokale IP: {ORANGE}{own}{RESET}\n")
    base = ask(f"Netzwerk-Basis (Enter = {default_base}): ") or default_base
    if not re.fullmatch(r"\d{1,3}\.\d{1,3}\.\d{1,3}", base):
        print(f"  {RED}Ungueltig. Beispiel: 192.168.178{RESET}")
        return

    ips = [f"{base}.{i}" for i in range(1, 255)]
    print(f"\n  {WHITE}Scanne {base}.1 - {base}.254 ...{RESET}\n")

    def probe(ip):
        if not ping(ip):
            return None
        try:
            host = socket.gethostbyaddr(ip)[0]
        except Exception:
            host = "-"
        return ip, host

    found = []
    with ThreadPoolExecutor(max_workers=64) as ex:
        futures = [ex.submit(probe, ip) for ip in ips]
        for i, f in enumerate(as_completed(futures), 1):
            res = f.result()
            if res:
                found.append(res)
            progress(i, len(ips), f"gefunden: {len(found)}")
    print("\n")

    if not found:
        print(f"  {YELLOW}Keine Geraete gefunden (Ping evtl. durch Firewall blockiert).{RESET}")
        return
    macs = arp_table()
    found.sort(key=lambda r: tuple(int(p) for p in r[0].split(".")))
    print(f"  {ORANGE}{'IP-Adresse':<17}{'MAC-Adresse':<20}Name{RESET}")
    print(f"  {GRAY}{'-' * 60}{RESET}")
    for ip, host in found:
        tag = f"  {GREEN}<- du{RESET}" if ip == own else ""
        print(f"  {ip:<17}{macs.get(ip, '-'):<20}{host}{tag}")
    print(f"\n  {GREEN}{len(found)} Geraete online.{RESET}")


# ----------------------------------------------------------------------------
# 3) Port-Scanner (nur eigene Geraete / mit Erlaubnis!)
# ----------------------------------------------------------------------------
def parse_ports(spec):
    ports = set()
    for part in spec.split(","):
        part = part.strip()
        if not part:
            continue
        if "-" in part:
            a, b = part.split("-", 1)
            ports.update(range(int(a), int(b) + 1))
        else:
            ports.add(int(part))
    ports = {p for p in ports if 1 <= p <= 65535}
    if len(ports) > 5000:
        raise ValueError("Maximal 5000 Ports pro Scan.")
    return sorted(ports)


def port_scanner():
    target = ask("IP oder Domain: ")
    if not target:
        return
    try:
        ip = socket.gethostbyname(target)
    except Exception:
        print(f"  {RED}Host nicht gefunden.{RESET}")
        return

    print(f"\n  {YELLOW}Nur Geraete scannen, die dir gehoeren oder fuer die du "
          f"eine Erlaubnis hast.{RESET}")
    if ask("Ist das der Fall? (j/n): ").lower() not in ("j", "ja", "y"):
        print(f"  {GRAY}Abgebrochen.{RESET}")
        return

    spec = ask("Ports (Enter = haeufige, oder z.B. 1-1024 / 80,443): ")
    try:
        ports = parse_ports(spec) if spec else sorted(COMMON_PORTS)
    except ValueError as e:
        print(f"  {RED}Ungueltige Eingabe: {e}{RESET}")
        return

    print(f"\n  {WHITE}Scanne {ip} ({len(ports)} Ports) ...{RESET}\n")

    def probe(port):
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.settimeout(0.7)
        try:
            return port, s.connect_ex((ip, port)) == 0
        except Exception:
            return port, False
        finally:
            s.close()

    open_ports = []
    with ThreadPoolExecutor(max_workers=200) as ex:
        futures = [ex.submit(probe, p) for p in ports]
        for i, f in enumerate(as_completed(futures), 1):
            port, is_open = f.result()
            if is_open:
                open_ports.append(port)
            progress(i, len(ports), f"offen: {len(open_ports)}")
    print("\n")

    if not open_ports:
        print(f"  {YELLOW}Keine offenen Ports gefunden.{RESET}")
        return
    print(f"  {ORANGE}{'Port':<8}Dienst{RESET}")
    print(f"  {GRAY}{'-' * 30}{RESET}")
    for p in sorted(open_ports):
        try:
            svc = COMMON_PORTS.get(p) or socket.getservbyport(p)
        except Exception:
            svc = "-"
        print(f"  {GREEN}{p:<8}{RESET}{svc}")
    print(f"\n  {GREEN}{len(open_ports)} offene Ports.{RESET}")


# ----------------------------------------------------------------------------
# 4) IP-Info
# ----------------------------------------------------------------------------
def ip_info():
    if not need_internet():
        return
    target = ask("IP oder Domain (Enter = deine eigene oeffentliche IP): ")
    url = ("http://ip-api.com/json/" + quote(target) +
           "?lang=de&fields=status,message,query,country,regionName,city,zip,"
           "lat,lon,timezone,isp,org,as")
    try:
        with urllib.request.urlopen(
                urllib.request.Request(url, headers={"User-Agent": UA}),
                timeout=8) as r:
            data = json.loads(r.read().decode("utf-8"))
    except Exception as e:
        print(f"  {RED}Abfrage fehlgeschlagen: {e}{RESET}")
        return
    if data.get("status") != "success":
        print(f"  {RED}Nicht gefunden: {data.get('message', 'unbekannter Fehler')}{RESET}")
        return
    rows = [
        ("IP", data.get("query")), ("Land", data.get("country")),
        ("Region", data.get("regionName")), ("Stadt", data.get("city")),
        ("PLZ", data.get("zip")), ("Zeitzone", data.get("timezone")),
        ("Anbieter", data.get("isp")), ("Organisation", data.get("org")),
        ("AS", data.get("as")),
        ("Koordinaten", f"{data.get('lat')}, {data.get('lon')}"),
    ]
    print()
    for k, v in rows:
        print(f"  {ORANGE}{k:<14}{RESET}{v or '-'}")
    print(f"\n  {GRAY}Standort ist nur eine grobe Schaetzung (meist Stadt des Anbieters).{RESET}")


# ----------------------------------------------------------------------------
# 5) DNS-Lookup
# ----------------------------------------------------------------------------
def dns_lookup():
    if not need_internet():
        return
    domain = ask("Domain (z.B. example.com): ")
    if not domain:
        return
    try:
        infos = socket.getaddrinfo(domain, None)
    except Exception:
        print(f"  {RED}Keine DNS-Antwort - Domain existiert nicht oder ist nicht registriert.{RESET}")
        return
    seen = []
    for fam, _, _, _, addr in infos:
        ip = addr[0]
        if ip not in seen:
            seen.append(ip)
    print()
    for ip in seen:
        typ = "IPv6" if ":" in ip else "IPv4"
        try:
            rev = socket.gethostbyaddr(ip)[0]
        except Exception:
            rev = "-"
        print(f"  {ORANGE}{typ:<6}{RESET}{ip:<40}{GRAY}{rev}{RESET}")


