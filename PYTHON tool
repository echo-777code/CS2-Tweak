def init_console():
    if os.name == "nt":
        os.system("")  # schaltet ANSI-Farben in cmd ein
        os.system("title Echo AI")
        os.system("mode con: cols=100 lines=40 >nul 2>&1")
    try:
        sys.stdout.reconfigure(encoding="utf-8", errors="replace")
    except Exception:
        pass


def clear():
    os.system("cls" if os.name == "nt" else "clear")


def _big_text(text):
    font = {
        "E": [" ___ ", "| __|", "| _| ", "|___|"],
        "C": ["  ___ ", " / __|", "| (__ ", " \\___|"],
        "H": [" _  _ ", "| || |", "| __ |", "|_||_|"],
        "O": ["  ___  ", " / _ \\ ", "| (_) |", " \\___/ "],
        "A": ["   _   ", "  /_\\  ", " / _ \\ ", "/_/ \\_\\"],
        "I": [" ___ ", "|_ _|", " | | ", "|___|"],
        " ": ["    ", "    ", "    ", "    "],
    }
    rows = ["", "", "", ""]
    for ch in text:
        for i in range(4):
            rows[i] += font[ch][i]
    return rows


def banner():
    print()
    for row in _big_text("ECHO AI"):
        print(f"  {ORANGE}{BOLD}{row}{RESET}")
    print(f"  {GRAY}{'-' * 44}{RESET}")
    print(f"  {GRAY}Toolbox  |  Namen, Netzwerk, DNS{RESET}\n")


def progress(done, total, label=""):
    width = 30
    filled = int(width * done / total) if total else width
    bar = "#" * filled + "-" * (width - filled)
    sys.stdout.write(f"\r  {ORANGE}[{bar}]{RESET} {done}/{total}  {label[:26]:<26}")
    sys.stdout.flush()


def ask(prompt):
    return input(f"  {ORANGE}>{RESET} {prompt}").strip()


def pause():
    try:
        input(f"\n  {GRAY}Enter druecken, um zum Menue zurueckzukehren ...{RESET}")
    except EOFError:
        pass


def splash():
    clear()
    banner()
    print(f"  {WHITE}Lade Echo AI ...{RESET}\n")
    for i in range(41):
        progress(i, 40, "starte")
        time.sleep(0.05)
    print()
    time.sleep(0.3)


def has_internet():
    try:
        socket.gethostbyname("example.com")
        return True
    except Exception:
        return False


def need_internet():
    if has_internet():
        return True
    print(f"  {RED}Keine Internetverbindung - bitte pruefen und erneut versuchen.{RESET}")
    return False


# ----------------------------------------------------------------------------
# 1) Namens-Check: Plattformen + Domains
# ----------------------------------------------------------------------------
def check_url(url, marker=None, weak=False):
    req = urllib.request.Request(
        url, headers={"User-Agent": UA, "Accept-Language": "en-US,en;q=0.8"}
    )
    try:
        with urllib.request.urlopen(req, timeout=8) as resp:
            if marker:
                body = resp.read(300_000).decode("utf-8", "ignore").lower()
                return "free" if marker.lower() in body else "taken"
            return "unclear" if weak else "taken"
    except urllib.error.HTTPError as e:
        if e.code in (404, 410):
            return "free"
        return "unclear"  # 403 / 429 / 999 ... = Seite blockt Bots
    except Exception:
        return "unclear"


def check_domain(domain):
    try:
        socket.gethostbyname(domain)
        return "taken"
    except socket.gaierror:
        return "free"  # keine DNS-Antwort = sehr wahrscheinlich nicht registriert
    except Exception:
        return "unclear"


def name_check():
    if not need_internet():
        return
    name = ask("Name eingeben: ").replace(" ", "")
    if not name:
        print(f"  {YELLOW}Kein Name eingegeben.{RESET}")
        return

    slug = "".join(c for c in name.lower() if c.isalnum() or c == "-")
    jobs = []
    for pname, tpl, marker, weak in PLATFORMS:
        url = tpl.format(quote(name, safe=""))
        jobs.append(("Plattform", pname, url,
                     lambda u=url, m=marker, w=weak: check_url(u, m, w)))
    if slug:
        for tld in DOMAINS:
            dom = slug + tld
            jobs.append(("Domain", dom, "https://" + dom,
                         lambda d=dom: check_domain(d)))

    print(f"\n  {WHITE}Durchsuche {len(jobs)} Plattformen/Domains fuer "
          f"{ORANGE}{name}{WHITE} ...{RESET}\n")

    def run(job):
        cat, label, url, fn = job
        try:
            return cat, label, url, fn()
        except Exception:
            return cat, label, url, "unclear"

    results = []
    with ThreadPoolExecutor(max_workers=16) as ex:
        futures = [ex.submit(run, j) for j in jobs]
        for i, f in enumerate(as_completed(futures), 1):
            res = f.result()
            results.append(res)
            progress(i, len(jobs), res[1])
    print("\n")

    look = {"free": (GREEN, "FREI  "), "taken": (RED, "BELEGT"),
            "unclear": (YELLOW, "UNKLAR")}
    order = {"free": 0, "unclear": 1, "taken": 2}
    results.sort(key=lambda r: (order[r[3]], r[0], r[1]))
    for cat, label, url, status in results:
        col, txt = look[status]
        print(f"  {col}{txt}{RESET}  {cat:<9} {label:<20} {GRAY}{url}{RESET}")

    n_free = sum(1 for r in results if r[3] == "free")
    n_taken = sum(1 for r in results if r[3] == "taken")
    n_unclear = sum(1 for r in results if r[3] == "unclear")
    print(f"\n  {GREEN}{n_free} frei{RESET}  |  {RED}{n_taken} belegt{RESET}  |  "
          f"{YELLOW}{n_unclear} unklar{RESET}")
    print(f"  {GRAY}UNKLAR = Seite blockt Bots, Link bitte selbst pruefen.{RESET}")

    if ask("\nErgebnis als .txt speichern? (j/n): ").lower() in ("j", "ja", "y"):
        fname = f"echo_ai_{slug or 'name'}.txt"
        with open(fname, "w", encoding="utf-8") as fh:
            fh.write(f"Echo AI - Namens-Check: {name}\n\n")
            for cat, label, url, status in results:
                fh.write(f"{status.upper():<8}{cat:<10}{label:<20}{url}\n")
        print(f"  {GREEN}Gespeichert:{RESET} {os.path.abspath(fname)}")


