ACTIONS = {
    "1": ("Namens-Check       (Plattformen + Domains)", name_check),
    "2": ("IP-Scanner         (Geraete im lokalen Netzwerk)", ip_scanner),
    "3": ("Port-Scanner       (offene Ports eines Hosts)", port_scanner),
    "4": ("IP-Info            (Standort/Anbieter einer IP oder Domain)", ip_info),
    "5": ("DNS-Lookup         (Domain -> IP)", dns_lookup),
}


def main():
    init_console()
    splash()
    while True:
        clear()
        banner()
        for key, (title, _) in ACTIONS.items():
            print(f"  {ORANGE}[{key}]{RESET} {title}")
        print(f"  {ORANGE}[0]{RESET} Beenden\n")
        try:
            choice = ask("Auswahl: ")
        except (KeyboardInterrupt, EOFError):
            choice = "0"
        if choice == "0":
            print(f"\n  {ORANGE}Bis bald - Echo AI{RESET}\n")
            break
        if choice not in ACTIONS:
            print(f"\n  {RED}Bitte eine Zahl aus dem Menue eingeben.{RESET}")
            time.sleep(1.2)
            continue
        title, func = ACTIONS[choice]
        clear()
        banner()
        print(f"  {BOLD}{ORANGE}[{choice}] {title.split('(')[0].strip()}{RESET}\n")
        try:
            func()
        except KeyboardInterrupt:
            print(f"\n  {YELLOW}Abgebrochen.{RESET}")
        except Exception as e:
            print(f"\n  {RED}Fehler: {e}{RESET}")
        pause()


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:  # Fenster nicht sofort schliessen, damit man den Fehler lesen kann
        print(f"\nFehler: {exc}")
        input("Enter zum Beenden ...")
